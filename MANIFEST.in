include firestarter/data/chip_database.json
include firestarter/data/pinouts.json
include firestarter/data/database_overrides.json
include firestarter/data/avrdude.conf
include firestarter/database.py
include firestarter/ic_layout.py
include firestarter/avr_tool.py
include firestarter/main.py
include firestarter/__init__.py
include README.md
include LICENSE

# setuptools-scm adds every git-tracked file to the sdist. Keep repo tooling,
# datasheets and editor config out of the published archive.
prune .github
prune .vscode
prune datasheets
prune tools
exclude .git-blame-ignore-revs .gitignore .pre-commit-config.yaml
exclude CLAUDE.md DEVELOPMENT.md SUPPORT.md requirements.txt *.sh
