  "meta": {
    "decision": "tests/golden/wire_dict_baseline.json is preserved byte-unchanged. This layer is the expected change on the 29 records of the DIP28_2764_8K pin map.",
    "cause": "tools/build_db.py now resolves pm_idx 21 to DIP28_2764_8K. infoic.xml <maps> index 21 leaves pin 26 unbonded, so the bus has 13 address lines and not 14. Pin 27 (PGM) is the rw-pin, so the firmware drives PGM high for read and low for write. Before, nothing drove pin 27, so PGM stayed low during read, and TMS2764 read 0x03 at byte 0 on the bench.",
    "overlap": "None. No earlier layer names these records.",
    "counts": {
      "records": 29
    },
    "how_to_update": "Change this file only together with the generator or pinouts.json change that moves these values, and name the chips in the commit message."
  }
}
